# Copie para .env (não versionar segredos reais) e ajuste conforme o ambiente.
# docker compose lê variáveis de .env automaticamente.

# Banco de dados (PostgreSQL)
POSTGRES_DB=psicology
POSTGRES_USER=psicology
POSTGRES_PASSWORD=troque-esta-senha
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/psicology
SPRING_DATASOURCE_USERNAME=psicology
SPRING_DATASOURCE_PASSWORD=troque-esta-senha

# Segurança (OBRIGATÓRIO em produção: use um segredo longo e aleatório)
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-pelo-menos-32-bytes

# CORS (origens permitidas, separadas por vírgula)
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*
