# Copie para .env (NÃO versionar segredos reais) e ajuste conforme o ambiente.
# docker compose lê variáveis de .env automaticamente.

# Banco de dados (PostgreSQL) - use senhas fortes em produção
POSTGRES_DB=psicology
POSTGRES_USER=psicology
POSTGRES_PASSWORD=troque-esta-senha-forte
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/psicology
SPRING_DATASOURCE_USERNAME=psicology
SPRING_DATASOURCE_PASSWORD=troque-esta-senha-forte

# Segurança (OBRIGATÓRIO em produção)
# Gere um segredo aleatório com pelo menos 64 caracteres, por exemplo:
# openssl rand -base64 64
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-pelo-menos-64-caracteres
JWT_ACCESS_EXPIRATION_MS=900000

# CORS (origens permitidas, separadas por vírgula). Em produção, use apenas o domínio real.
APP_CORS_ALLOWED_ORIGIN_PATTERNS=https://seu-dominio.com
